# Safe local default: no external LLM/API call.
USE_REAL_LLM=false
LLM_PROVIDER=gemini
LLM_REQUEST_TIMEOUT_SECONDS=20
USE_REAL_EMBEDDINGS=false

# Only required when intentionally testing a hosted provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-flash-lite-latest
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Set this to a trained model directory on the school server.
ML_SENTIMENT_MODEL_PATH=

# Collection-only Gemini opt-in. Other features stay in rule mode.
REWRITE_WITH_LLM=false
DOCENT_WITH_LLM=false
MAX_DAILY_REWRITE_CALLS=400
REWRITE_MIN_INTERVAL_SECONDS=6
MAX_REAL_LLM_CALLS_PER_PROCESS=20
REWRITE_LEDGER_PATH=data/rewrite_calls.sqlite3
